<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SMART_IDUKA" targetNamespace="https://smartiduka.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.53.0">
  <bpmn:process id="Process_SMART_IDUKA" name="SMART IDUKA - Shop Management and Automated Accounting" isExecutable="true">
    <bpmn:startEvent id="StartEvent" name="Shop management begins" />
    <bpmn:task id="SetupShop" name="Set up shop profile and business settings" />
    <bpmn:task id="RegisterCatalog" name="Register products, categories and suppliers" />
    <bpmn:exclusiveGateway id="ChooseOperation" name="Choose business operation" gatewayDirection="Mixed">
      <bpmn:incoming>F22</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:task id="RecordPurchase" name="Record supplier purchase and invoice" />
    <bpmn:task id="CalculateLandedCost" name="Calculate acquisition cost and landed costs" />
    <bpmn:task id="UpdateStockPurchase" name="Update inventory and stock movement history" />
    <bpmn:task id="SmartPricing" name="Calculate and recommend selling prices" />
    <bpmn:task id="RecordSale" name="Record sale and sale items" />
    <bpmn:exclusiveGateway id="CheckStock" name="Is sufficient stock available?" gatewayDirection="Diverging" />
    <bpmn:task id="LowStockAlert" name="Show low-stock alert and recommend replenishment" />
    <bpmn:exclusiveGateway id="RecordPaymentChoice" name="Payment received in full?" gatewayDirection="Diverging" />
    <bpmn:task id="RecordPayment" name="Record payment and payment method" />
    <bpmn:task id="RegisterReceivable" name="Register customer credit / receivable" />
    <bpmn:exclusiveGateway id="MergePayment" name="Continue after payment or credit entry" gatewayDirection="Mixed" />
    <bpmn:task id="PostSaleAccounting" name="Update inventory, balances and double-entry accounts" />
    <bpmn:task id="RecordExpense" name="Record business expense" />
    <bpmn:task id="PostExpense" name="Post expense to accounting records" />
    <bpmn:task id="GenerateReports" name="Generate dashboard and financial reports" />
    <bpmn:task id="ReviewPerformance" name="Review profit, cash, debts and stock performance" />
    <bpmn:exclusiveGateway id="ContinueGateway" name="Continue managing the shop?" gatewayDirection="Diverging" />
    <bpmn:endEvent id="EndEvent" name="Shop management session ends" />
    <bpmn:sequenceFlow id="F01" sourceRef="StartEvent" targetRef="SetupShop" />
    <bpmn:sequenceFlow id="F02" sourceRef="SetupShop" targetRef="RegisterCatalog" />
    <bpmn:sequenceFlow id="F03" sourceRef="RegisterCatalog" targetRef="ChooseOperation" />
    <bpmn:sequenceFlow id="F04" name="Purchase / restock" sourceRef="ChooseOperation" targetRef="RecordPurchase" />
    <bpmn:sequenceFlow id="F05" sourceRef="RecordPurchase" targetRef="CalculateLandedCost" />
    <bpmn:sequenceFlow id="F06" sourceRef="CalculateLandedCost" targetRef="UpdateStockPurchase" />
    <bpmn:sequenceFlow id="F07" sourceRef="UpdateStockPurchase" targetRef="SmartPricing" />
    <bpmn:sequenceFlow id="F08" sourceRef="SmartPricing" targetRef="ChooseOperation" />
    <bpmn:sequenceFlow id="F09" name="Make a sale" sourceRef="ChooseOperation" targetRef="RecordSale" />
    <bpmn:sequenceFlow id="F10" sourceRef="RecordSale" targetRef="CheckStock" />
    <bpmn:sequenceFlow id="F11" name="Yes - stock available" sourceRef="CheckStock" targetRef="RecordPaymentChoice" />
    <bpmn:sequenceFlow id="F12" name="No - insufficient stock" sourceRef="CheckStock" targetRef="LowStockAlert" />
    <bpmn:sequenceFlow id="F13" name="Replenish stock" sourceRef="LowStockAlert" targetRef="RecordPurchase" />
    <bpmn:sequenceFlow id="F14" name="Yes - paid" sourceRef="RecordPaymentChoice" targetRef="RecordPayment" />
    <bpmn:sequenceFlow id="F15" name="No - credit sale" sourceRef="RecordPaymentChoice" targetRef="RegisterReceivable" />
    <bpmn:sequenceFlow id="F16" sourceRef="RecordPayment" targetRef="MergePayment" />
    <bpmn:sequenceFlow id="F17" sourceRef="RegisterReceivable" targetRef="MergePayment" />
    <bpmn:sequenceFlow id="F18" sourceRef="MergePayment" targetRef="PostSaleAccounting" />
    <bpmn:sequenceFlow id="F19" sourceRef="PostSaleAccounting" targetRef="ChooseOperation" />
    <bpmn:sequenceFlow id="F20" name="Record expense" sourceRef="ChooseOperation" targetRef="RecordExpense" />
    <bpmn:sequenceFlow id="F21" sourceRef="RecordExpense" targetRef="PostExpense" />
    <bpmn:sequenceFlow id="F22" sourceRef="PostExpense" targetRef="ChooseOperation" />
    <bpmn:sequenceFlow id="F23" name="View reports" sourceRef="ChooseOperation" targetRef="GenerateReports" />
    <bpmn:sequenceFlow id="F24" sourceRef="GenerateReports" targetRef="ReviewPerformance" />
    <bpmn:sequenceFlow id="F25" sourceRef="ReviewPerformance" targetRef="ContinueGateway" />
    <bpmn:sequenceFlow id="F26" name="Yes" sourceRef="ContinueGateway" targetRef="ChooseOperation" />
    <bpmn:sequenceFlow id="F27" name="No" sourceRef="ContinueGateway" targetRef="EndEvent" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SMART_IDUKA">
    <bpmndi:BPMNPlane id="BPMNPlane_SMART_IDUKA" bpmnElement="Process_SMART_IDUKA">
